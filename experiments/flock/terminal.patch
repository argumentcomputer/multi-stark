+impl PreparedPlonkWitness<'_> {
+  fn value(&self, wire: Option<PlonkWireV1>) -> Option<Fr> {
+    match wire {
+      None => Some(Fr::zero()),
+      Some(PlonkWireV1::R1cs(variable)) => {
+        self.assignment.get(variable.index() as usize).copied()
