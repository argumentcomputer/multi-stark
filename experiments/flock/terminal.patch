+// Random-access omega powers using O(sqrt(n)) storage instead of a full column.
+struct DomainPowers {
+  low: Vec<Fr>,
+  high: Vec<Fr>,
+}
+
+impl DomainPowers {
+  fn new(omega: Fr, n: usize) -> Self {
+    let stride = 1usize << n.ilog2().div_ceil(2);
+    let powers = |base, count| {
+      let mut value = Fr::ONE;
+      (0..count)
+        .map(|_| {
+          let result = value;
+          value *= base;
+          result
+        })
+        .collect()
+    };
+    Self {
+      low: powers(omega, stride),
+      high: powers(omega.pow([stride as u64]), n.div_ceil(stride)),
+    }
+  }
+
+  fn get(&self, row: usize) -> Fr {
+    self.low[row % self.low.len()] * self.high[row / self.low.len()]
+  }
+}
 
