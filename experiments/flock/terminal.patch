+    column: usize,
+    start: usize,
+    output: &mut [Fr],
+  ) -> Result<(), PlonkArithmetizationError> {
+    let end = start
+      .checked_add(output.len())
+      .ok_or(PlonkArithmetizationError::CountOverflow)?;
+    if column >= 3 || end > self.output.len() {
+      return Err(PlonkArithmetizationError::CountOverflow);
+    }
+    if column == 2 {
+      output.copy_from_slice(&self.output[start..end]);
+    } else {
+      for (row, value) in (start..end).zip(output) {
+        *value = self.cell(column, row)?;
+      }
+    }
+    Ok(())
+  }
+
+  fn materialize(self) -> Result<PlonkWitnessV1, PlonkArithmetizationError> {
+    let mut a = vec![Fr::zero(); self.output.len()];
+    let mut b = vec![Fr::zero(); self.output.len()];
+    self.read_column(0, 0, &mut a)?;
+    self.read_column(1, 0, &mut b)?;
+    Ok(PlonkWitnessV1 { columns: [a, b, self.output] })
+  }
+}
