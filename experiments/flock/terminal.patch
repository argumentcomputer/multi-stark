+/// Gate rows sharing identical coefficient records.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct PlonkGateRowsV1 {
+  rows: Vec<StoredGate>,
+  selectors: Vec<[Fr; 5]>,
+}
+
+impl PlonkGateRowsV1 {
+  pub fn len(&self) -> usize {
+    self.rows.len()
+  }
+  pub fn is_empty(&self) -> bool {
+    self.rows.is_empty()
+  }
+  pub fn selector_records(&self) -> usize {
+    self.selectors.len()
+  }
+  /// Stored payload only; excludes Vec spare capacity and allocator overhead.
+  pub fn storage_payload_bytes(&self) -> usize {
+    self.rows.len() * size_of::<StoredGate>()
+      + self.selectors.len() * size_of::<[Fr; 5]>()
+  }
+  pub fn get(&self, index: usize) -> Option<PlonkGateV1> {
+    self.rows.get(index).map(|row| self.decode(row))
+  }
+  pub fn iter(
+    &self,
+  ) -> impl ExactSizeIterator<Item = PlonkGateV1> + Clone + '_ {
+    self.rows.iter().map(|row| self.decode(row))
+  }
+  fn decode(&self, row: &StoredGate) -> PlonkGateV1 {
+    let [ql, qr, qm, qo, qc] = self.selectors[row.selectors as usize];
+    let wires = row.wires.map(|wire| {
+      if wire == 0 {
+        None
+      } else if wire >> 63 != 0 {
+        Some(PlonkWireV1::Auxiliary((wire & (u64::MAX >> 1)) - 1))
+      } else {
+        Some(PlonkWireV1::R1cs(Variable::from_index(
+          u32::try_from(wire - 1).expect("encoded R1CS index"),
+        )))
+      }
+    });
+    PlonkGateV1 { phase: row.phase, wires, ql, qr, qm, qo, qc }
+  }
+  fn encode(
+    &mut self,
+    gate: PlonkGateV1,
+    ids: &mut HashMap<[Fr; 5], u32>,
+  ) -> Result<StoredGate, PlonkArithmetizationError> {
+    let mut wires = [0; 3];
+    for (encoded, wire) in wires.iter_mut().zip(gate.wires) {
+      *encoded = match wire {
+        None => 0,
+        Some(PlonkWireV1::R1cs(variable)) => u64::from(variable.index()) + 1,
+        Some(PlonkWireV1::Auxiliary(index)) if index < (u64::MAX >> 1) => {
+          (1u64 << 63) | (index + 1)
+        },
+        Some(PlonkWireV1::Auxiliary(_)) => {
+          return Err(PlonkArithmetizationError::CountOverflow);
+        },
+      };
+    }
+    let coefficients = [gate.ql, gate.qr, gate.qm, gate.qo, gate.qc];
+    let selectors = if let Some(&id) = ids.get(&coefficients) {
+      id
+    } else {
+      let id = u32::try_from(self.selectors.len())
+        .map_err(|_| PlonkArithmetizationError::CountOverflow)?;
+      self.selectors.push(coefficients);
+      ids.insert(coefficients, id);
+      id
+    };
+    Ok(StoredGate { phase: gate.phase, wires, selectors })
+  }
 }
 
