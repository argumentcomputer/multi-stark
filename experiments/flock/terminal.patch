+    }
+  }
+
+  fn cell(
+    &self,
+    column: usize,
+    row: usize,
+  ) -> Result<Fr, PlonkArithmetizationError> {
+    // Decode just the wire: selector coefficients are irrelevant to a read.
+    let encoded = self
+      .arithmetization
+      .gates
+      .rows
+      .get(row)
+      .and_then(|gate| gate.wires.get(column))
+      .copied()
+      .ok_or(PlonkArithmetizationError::CountOverflow)?;
+    let value = if encoded == 0 {
+      Some(Fr::zero())
+    } else if encoded >> 63 != 0 {
+      self.value(Some(PlonkWireV1::Auxiliary((encoded & (u64::MAX >> 1)) - 1)))
+    } else {
