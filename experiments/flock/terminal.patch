+/// Bind a fixed prefix and application public words to the native Flock
+/// public-vector digest. The caller supplies the prefix from its verifier key.
+pub fn constrain_application_public_values(
+  builder: &mut R1csBuilder,
+  circuit_digest: [u8; 32],
+  fixed_prefix: &[[u8; 16]],
+  public_words: &[crate::Variable],
+  values: &[[u8; 16]],
+  payload_indices: [usize; 2],
+  byte_payloads: &[Vec<F128TranscriptWordV1>],
+) -> Result<Vec<F128VariablesV1>, F128StatementCircuitError> {
+  if values.len() != fixed_prefix.len() + public_words.len() {
+    return Err(F128StatementCircuitError::InternalShape("application public count"));
+  }
+  let circuit_payload = payload(byte_payloads, payload_indices[0] as u64, "circuit digest")?;
+  bind_constant_digest(builder, circuit_payload, circuit_digest, "circuit digest")?;
+  let variables = values.iter().copied().map(|v| alloc_f128_private(builder, v, ConstraintPhase::Statement)).collect::<Result<Vec<_>, _>>()?;
+  for (variable, constant) in variables.iter().zip(fixed_prefix) {
+    crate::f128::enforce_f128_equal_constant(builder, variable, *constant, ConstraintPhase::Statement);
+  }
+  for (variable, public) in variables[fixed_prefix.len()..].iter().zip(public_words) {
+    builder.enforce_zero(ConstraintPhase::Statement,
+      crate::f128::packed_f128_variables(variable).minus(&LinearCombination::from_variable(*public)));
+  }
+  let digest = constrain_public_values_digest(builder, &variables)?;
+  let digest_payload = payload(byte_payloads, payload_indices[1] as u64, "public-values digest")?;
+  bind_computed_digest(builder, &digest, digest_payload, native_public_values_digest(values), "public-values digest", ConstraintPhase::Statement)?;
+  Ok(variables)
+}
